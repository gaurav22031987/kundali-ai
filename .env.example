OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kundali
KUNDALI_USER_ID=local-user
# Nominatim-compatible identity; use a contact address or URL you control in production.
GEOCODER_USER_AGENT=KundaliAI/1.0 (contact: you@example.com)
GEOCODER_TIMEOUT=15
